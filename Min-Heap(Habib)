
static class MinHeap { 

    private PriorityQueue<Integer> heap = new PriorityQueue<>(); 

  

    // Insert a value into the Min-Heap 

    public void insert(int value) { 

        if (value < 0) { 

            throw new IllegalArgumentException("Priority value cannot be negative"); 

        } 

        heap.add(value);              // add at end, then sift up 

    } 

  

    // Remove and return the minimum value 

    public int extractMin() { 

        if (heap.isEmpty()) { 

            throw new NoSuchElementException("Heap is empty"); 

        } 

        return heap.poll();           // remove root, sift down 

    } 

  

    // Extra: access the minimum without removing it 

    public int peekMin() { 

        if (heap.isEmpty()) { 

            throw new NoSuchElementException("Heap is empty"); 

        } 

        return heap.peek(); 

    } 

}
