import java.util.NoSuchElementException;

public class SplayTreeDemo
{
    static class SplayTree
    {
        private class Node
        {
            int key;
            Node left, right;

            Node(int key)
            {
                this.key = key;
            }
        }

        private Node root;

        private Node rotateRight(Node x)
        {
            Node y = x.left;
            x.left = y.right;
            y.right = x;
            return y;
        }

        private Node rotateLeft(Node x)
        {
            Node y = x.right;
            x.right = y.left;
            y.left = x;
            return y;
        }

        // Move node with key, or the last node on
        // the search path, to the root
        private Node splay(Node node, int key)
        {
            if (node == null || node.key == key)
            {
                return node;
            }

            if (key < node.key)
            {
                if (node.left == null)
                {
                    return node;
                }

                if (key < node.left.key)
                {
                    // Zig-Zig
                    node.left.left =
                        splay(node.left.left, key);

                    node = rotateRight(node);
                }
                else if (key > node.left.key)
                {
                    // Zig-Zag
                    node.left.right =
                        splay(node.left.right, key);

                    if (node.left.right != null)
                    {
                        node.left =
                            rotateLeft(node.left);
                    }
                }

                return (node.left == null)
                    ? node
                    : rotateRight(node);
            }
            else
            {
                if (node.right == null)
                {
                    return node;
                }

                if (key > node.right.key)
                {
                    // Zag-Zag
                    node.right.right =
                        splay(node.right.right, key);

                    node = rotateLeft(node);
                }
                else if (key < node.right.key)
                {
                    // Zag-Zig
                    node.right.left =
                        splay(node.right.left, key);

                    if (node.right.left != null)
                    {
                        node.right =
                            rotateRight(node.right);
                    }
                }

                return (node.right == null)
                    ? node
                    : rotateLeft(node);
            }
        }

        public void insert(int value)
        {
            if (root == null)
            {
                root = new Node(value);
                return;
            }

            root = splay(root, value);

            if (root.key == value)
            {
                return; // Ignore duplicates
            }

            Node n = new Node(value);

            if (value < root.key)
            {
                n.right = root;
                n.left = root.left;
                root.left = null;
            }
            else
            {
                n.left = root;
                n.right = root.right;
                root.right = null;
            }

            root = n;
        }

        public boolean search(int value)
        {
            if (root == null)
            {
                return false;
            }

            root = splay(root, value);

            return root.key == value;
        }

        // For demonstration
        public int getRootValue()
        {
            if (root == null)
            {
                throw new NoSuchElementException(
                    "Tree is empty");
            }

            return root.key;
        }
    }

    public static void main(String[] args)
    {
        System.out.println("=================================");
        System.out.println("      SPLAY TREE DEMONSTRATION");
        System.out.println("=================================");

        SplayTree tree = new SplayTree();

        System.out.println("\nInserting values:");

        tree.insert(20);
        System.out.println("Inserted: 20");

        tree.insert(10);
        System.out.println("Inserted: 10");

        tree.insert(30);
        System.out.println("Inserted: 30");

        System.out.println(
            "\nCurrent Root: " +
            tree.getRootValue()
        );

        System.out.println("\nSearching for value: 10");

        boolean found = tree.search(10);

        System.out.println(
            "Search Result: " + found
        );

        System.out.println(
            "Root After Search: " +
            tree.getRootValue()
        );

        System.out.println("\nSearching for value: 50");

        boolean found2 = tree.search(50);

        System.out.println(
            "Search Result: " + found2
        );

        System.out.println(
            "Root After Unsuccessful Search: " +
            tree.getRootValue()
        );

        System.out.println("\n=================================");
        System.out.println("        PROGRAM COMPLETED");
        System.out.println("=================================");
    }
}
